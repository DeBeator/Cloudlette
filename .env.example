# Server-only ASP.NET Core API origin. Used by Next.js auth proxy routes only.
BACKEND_URL=http://localhost:5000
# Set this in Vercel for server-side proxy routes. Do not expose secrets with NEXT_PUBLIC_.

# Browser catalog/API mode. Local development defaults to `mock` when omitted.
# Production requires an explicit mode: `live` for a configured backend, or
# `mock` only for a clearly labelled demonstration deployment. When omitted,
# catalog requests fail safely instead of publishing placeholder inventory.
NEXT_PUBLIC_API_MODE=mock
# Optional public API origin for browser-accessible, non-auth endpoints.
# Leave empty when those endpoints are proxied through the same origin.
NEXT_PUBLIC_API_URL=

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
# TODO: replace with live key before go-live

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# TODO: set to https://cloudlette.com in production

# Media storage is selected and authorized by the backend. Server-only storage
# credentials must never be supplied to the frontend or prefixed with NEXT_PUBLIC_.
# ORACLE_STORAGE_NAMESPACE=
# ORACLE_STORAGE_BUCKET=
# ORACLE_ACCESS_KEY=
# ORACLE_SECRET_KEY=
